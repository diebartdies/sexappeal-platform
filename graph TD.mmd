flowchart TB
    classDef client fill:#f9f9f9,stroke:#333,stroke-width:2px
    classDef gateway fill:#e1f5fe,stroke:#36c,stroke-width:2px
    classDef backend fill:#e8f5e9,stroke:#0277bd,stroke-width:2px
    classDef database fill:#fff3e0,stroke:#2e7d32,stroke-width:2px
    classDef external fill:#fffde7,stroke:#ef6c00,stroke-width:2px
    classDef scripts fill:#f3e5f5,stroke:#558b2f,stroke-width:2px

    subgraph ClientLayer["1. Client / Frontend Layer"]
        U[Public Users / Guests]:::client
        P[Professionals]:::client
        A[Administrators]:::client
        SPA[Web Frontend<br/>HTML / CSS / Vanilla JS ES Modules]:::client
    end

    U --> SPA
    P --> SPA
    A --> SPA

    subgraph NetworkLayer["2. Gateway Layer"]
        Nginx[Nginx Reverse Proxy<br/>SSL / Rate Limit / Security Headers]:::gateway
    end

    SPA -- "REST API HTTPS" --> Nginx

    subgraph AppLayer["3. Application Layer Node.js Express 5"]
        Router[Express Router server.js]:::backend
        AuthMW[JWT and Role Middleware auth.js]:::backend
        Helmet[Helmet CORS Rate Limit]:::backend

        subgraph Controllers["Controllers"]
            AuthCtrl[Auth and Guest Login]:::backend
            ProfCtrl[Professionals Contact Shield]:::backend
            AdminCtrl[Admin Verifications Payments]:::backend
            PayCtrl[Receipt Upload]:::backend
            OutCtrl[WhatsApp Outreach]:::backend
            SeoCtrl[SEO SSR Sitemap Locations]:::backend
            FbCtrl[Feedback Respect Filter]:::backend
        end

        subgraph Engines["Background Engines 24h"]
            Billing[Billing Invoices Suspensions]:::backend
            CatBill[Category Billing Proration lastCatModDate]:::backend
            TrialRem[Trial Reminders]:::backend
            SeoLoc[SEO Location Registry]:::backend
        end

        ActivityLog[ActivityLog Traceability cookieless]:::backend
        Multer[Multer File Uploads]:::backend
    end

    Nginx --> Router
    Router --> Helmet
    Helmet --> AuthMW
    AuthMW --> Controllers
    Router --> Multer
    Controllers --> ActivityLog
    Billing --> CatBill

    subgraph StorageLayer["4. Data and Storage Layer"]
        Mongo[(MongoDB 4.4 Users Logs Leads Invoices)]:::database
        FS[(public uploads photos)]:::database
    end

    Controllers -- Mongoose ORM --> Mongo
    Engines -- Read Write --> Mongo
    ActivityLog --> Mongo
    Multer -- Save Images --> FS

    subgraph ExternalServices["5. External Services"]
        SMTP[SMTP Email Server]:::external
        WA[WhatsApp Web.js Platform Service]:::external
        ScrapeSites[External Directories Lead Sources]:::external
    end

    Controllers -- Notifications --> SMTP
    Engines -- Reminders Invoices --> SMTP
    OutCtrl --> WA
    SPA -- Contact redirect API --> WA

    subgraph OpsScripts["6. Operational Scripts"]
        Scraper[Puppeteer Scraper scrape phones]:::scripts
        WABot[WhatsApp Outreach Bot]:::scripts
        Watch[Server Watch Alerts]:::scripts
    end

    Scraper -- Scrape Leads --> ScrapeSites
    Scraper -- Insert Leads --> Mongo
    WABot -- Pending Leads --> Mongo
    WABot -- Bulk Messages --> WA
    Watch -- Health Alerts --> WA
