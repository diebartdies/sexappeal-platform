# Node modules
node_modules/
npm-debug.log

# Environment variables (NEVER PUSH THIS to GitHub)
.env
.env.*
!.env.example

# Uploaded user photos
public/uploads/

# Local MongoDB database volumes (if you use Docker volumes locally)
mongo-data/
db/

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/

# Local Docker overrides
docker-compose.override.yml

# Puppeteer / Chrome cache to prevent GitHub large file errors
.cache/

# Auto-generated SEO location registry (scripts/generate-seo-locations.js)
utils/seo-locations.generated.json

# MongoDB dumps and large archives (never push to GitHub)
*.archive
*.tar.gz
certbot/

# Local backups produced by scripts/clean-users.js (contain user PII)
backups/